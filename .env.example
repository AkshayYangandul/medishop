# MediShop Backend Environment Configuration
# Copy this file to 'backend/.env' and fill in your actual local values.
# NEVER commit the real .env file — it is already git-ignored.

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=medishop

# Optional: Full database connection URL (overrides the individual fields above if set)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/medishop

# JWT Signing Key (REQUIRED — minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace_this_with_a_64_hex_char_secret_generated_by_python_secrets

# JWT token lifetime in seconds (default: 3600 = 1 hour)
TOKEN_EXPIRE_SECONDS=3600
