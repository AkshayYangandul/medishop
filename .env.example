# MediShop Supabase Environment Configuration
# Copy this file to '.env' and fill in your Supabase project credentials.
# NOTE: Only include the public anon key. NEVER include the service_role secret key in frontend code.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
